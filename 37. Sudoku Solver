class Solution {
public:
    bool isValid(vector<vector<char>> &board, int row, int col, char digit){
        // check row and column validity
        for(int i=0; i<9; i++){
            if(board[row][i] == digit) return false;
            if(board[i][col] == digit) return false;
        }

        // check box validity
        int start_row = row/3 * 3;
        int start_col = col/3 * 3;

        for(int k=0; k<3; k++){
            for(int l =0; l<3; l++){

                if(board[start_row+k][start_col+l] == digit){
                    return false;
                }
            }
        }return true;
    }
    bool solve(vector<vector<char>> &board){
        for(int i=0; i<9; i++){
            for(int j=0; j<9; j++){
                if(board[i][j] == '.'){
                    
                    for(char d ='1'; d<='9'; d++){
                        if(isValid(board, i, j, d)){
                            board[i][j] = d;

                            if(solve(board) == true){
                                return true;
                            }
                            board[i][j] = '.';
                        }
                    }
                    return false;
                }
            }
        }return true;
    }
    void solveSudoku(vector<vector<char>>& board) {
        solve(board);
    }
};
