class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        int ans = 0;
        int left = 0;

        for(int i=0; i<nums.size() ; i++){
            if(nums[i] != val){
                int temp = nums[left];
                nums[left] = nums[i];
                nums[i] = temp;
                left++;
                ans++;
            }
        }return ans;
    }
};
