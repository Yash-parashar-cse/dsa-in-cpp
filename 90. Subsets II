class Solution {
public:
    void allSubs(vector<int>& nums, vector<int>& ans, int i, vector<vector<int>>& allSubsets){
        if(i == nums.size()){
            allSubsets.push_back(ans);
            return;
        }

        ans.push_back(nums[i]);
        allSubs(nums, ans, i+1, allSubsets);

        ans.pop_back();

        int index = i+1;
        while(index < nums.size() && nums[index] == nums[index-1]){
            index++;
        }

        allSubs(nums, ans, index, allSubsets);
    }
    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans;
        vector<vector<int>> allSubsets;
        sort(nums.begin(), nums.end());

        allSubs(nums, ans, 0, allSubsets);

        return allSubsets;
    }
};
