class ArrayStack {

    vector<int> arrayStack;
    int topIndex;
    int capacity;

public:
    ArrayStack(int size = 1000) {

        topIndex = -1;
        capacity = size;
        arrayStack.resize(capacity);
    }
    
    void push(int x) {
        if(topIndex == capacity - 1){
            cout<<"Stack overflow";
            return;
        }
        topIndex ++ ;
        arrayStack[topIndex] = x;
    }
    
    int pop() {
        if(topIndex == -1){
            cout<<"No element in the stack to pop out";
            return -1;
        }
        int ele = arrayStack[topIndex];
        topIndex--;
        return ele;
    }
    
    int top() {
        if(topIndex == -1){
            cout<<"No elemnt in the stack is there";
            return -1;
        }
        return arrayStack[topIndex];
    }
    
    bool isEmpty() {
        if(topIndex == -1){
            return true;
        }
        return false;
    }
};
