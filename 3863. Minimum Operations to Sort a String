class Solution {
public:
    int minOperations(string s) {
        int n = s.length();
        bool sorted = true;
        int max = s[0];
        int min = s[0];

        for(int i=0; i<n; i++){

            if(s[i] > max) max = s[i];
            if(s[i] < min) min = s[i];

            if(i>0 && s[i-1] > s[i]) sorted = false;
        }

        if(sorted) return 0;
        if(n == 2) return -1;

        // when the max and min are at their correct places
        if(s[0] == min || s[n-1] == max) return 1;

        // when min and max are in the middle of the string
        for(int i=1; i<(n-1); i++){
            if(s[i] == min || s[i] == max){
                return 2;
            }
        }
        
        // for all other positionings 
        return 3;

    }
};
