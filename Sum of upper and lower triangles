class Solution {
	public:
	vector<int> sumTriangles(vector<vector<int>> & mat) {
		// code here
		
		int n = mat.size();
		int m = mat[0].size();
		vector<int> ans;
		
		int lower = 0;
		int upper = 0;
		
		for (int i = 0; i<n; i++) {
			for (int j = 0; j<m; j++) {
				
				if (j >= i) {
					upper += mat[i][j];
				}
				if (i >= j) {
					lower += mat[i][j];
				}
			}
		}
		
		
		ans.push_back(upper);
		ans.push_back(lower);
		
		return ans;
		
	}
};
