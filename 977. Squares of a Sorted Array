class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        
        int n = nums.size();
        vector<int> ans(n);

        int i = 0;
        int j = n-1;
        int k = n-1;

        while(i<=j){
            int first_square = nums[i] * nums[i];
            int second_square = nums[j] * nums[j];

            if(first_square > second_square){

                ans[k] = first_square;
                i++;
            }
            else{
                ans[k] = second_square;
                j--;
            }
            k--;
        }return ans;
    }
};
