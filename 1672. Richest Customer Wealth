class Solution {
public:
    int maximumWealth(vector<vector<int>>& accounts) {
            int max_ans = 0;
            int n = accounts.size();
            int m = accounts[0].size();

            for(int i=0; i<n; i++){
                int this_max = 0;

                for(int j=0; j<m; j++){
                    this_max += accounts[i][j];
                }
                max_ans = max(max_ans, this_max);
            }
            return max_ans;
    }
};
