class Solution {
public:
    vector<int> luckyNumbers(vector<vector<int>>& matrix) {

        int n = matrix.size();
        int m = matrix[0].size();

        vector<int> rowMin;
        vector<int> colMax;
        vector<int> lucky;

        for (int i = 0; i < n; i++) {
            int rowmin = INT_MAX;
            for (int j = 0; j < m; j++) {

                rowmin = min(rowmin, matrix[i][j]);
            }
            rowMin.push_back(rowmin);
        }

        for (int i = 0; i < m; i++) {
            int colmax = INT_MIN;
            for (int j = 0; j < n; j++) {

                colmax = max(colmax, matrix[j][i]);
            }
            colMax.push_back(colmax);
        }

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < m; j++) {

                if (matrix[i][j] == rowMin[i] && matrix[i][j] == colMax[j]) {

                    lucky.push_back(matrix[i][j]);
                }
            }
        }
        return lucky;
    }
};
