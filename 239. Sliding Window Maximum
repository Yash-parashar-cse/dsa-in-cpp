class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {

        int n = nums.size();
        vector<int> result;
        deque<int> dq;

        for(int i=0; i<n; i++){

            // 1. Check for out of bounds index to the left when window size becomes > k
            while(!dq.empty() && dq.front() <= (i-k)){
                dq.pop_front();
            }

            // 2. remove the elements from the deque that are lesser than the coming element
            while(!dq.empty() && nums[dq.back()] <=  nums[i]){
                dq.pop_back();
            }

            // 3. Insert the new elemnt index in the deque
            dq.push_back(i);

            // 4. Add elemnt to the result when appropriate window size is reached
            if(i>=(k-1)){
                result.push_back(nums[dq.front()]);
            }
             
        }return result;
        
    }
};
