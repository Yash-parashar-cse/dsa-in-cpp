class Solution {
public:
    vector<vector<int>> imageSmoother(vector<vector<int>>& img) {
        
        int n = img.size();
        int m = img[0].size();
        vector<vector<int>> ans(n, vector<int> (m));

        vector<int> dir_row;
        vector<int> dir_col;

        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){

                dir_row = {i-1, i-1,i-1, i, i, i+1,i+1,i+1};
                dir_col = {j-1, j, j+1, j-1, j+1, j-1, j, j+1};

                int sum = img[i][j];
                int count = 1;

                for(int k=0; k<8; k++){
                     if(dir_row[k] <0 || dir_col[k] <0 || dir_col[k]>=m || dir_row[k] >=n){
                           
                            continue;
                            
                        }
                    else{
                        sum += img[dir_row[k]][dir_col[k]];
                        count++;
                    }
                    
                }
                ans[i][j] = sum/count;

            }
        }return ans;
    }
};
